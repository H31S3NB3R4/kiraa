# =====================================================================
# AI Finance Controller - environment configuration
#
# Copy this file to `.env` (repository root) and fill in real values.
# The `.env` file is git-ignored; NEVER commit real credentials.
# =====================================================================

# --- LLM provider (Gemini) -------------------------------------------
# Create a key at: https://aistudio.google.com/app/apikey
# Only needed from Phase 6 (agent controller) onward; the health
# endpoint and deterministic tools run without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Database ---------------------------------------------------------
# Default: local SQLite prototype (zero external services).
DATABASE_URL=sqlite:///./data/finance.db

# PostgreSQL example (the psycopg driver is already installed):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/finance_controller

# --- Application ------------------------------------------------------
APP_NAME=AI Finance Controller
ENVIRONMENT=development

# Comma-separated list of allowed browser origins (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Agent safety limits ----------------------------------------------
# Bounded maximum tool calls per agent run (guards against runaway loops).
AGENT_MAX_TOOL_CALLS=12

# --- Forecasting (Phase 4) ----------------------------------------------
# Minimum operating cash (INR) that projected balances are compared
# against in `forecast_cashflow`: below it -> HIGH risk, within 25%
# above it -> MEDIUM, otherwise LOW. A per-call `operating_threshold`
# argument overrides this setting.
OPERATING_THRESHOLD=50000
